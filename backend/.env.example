# PhotoFighter バックエンド環境変数
# このファイルをコピーして .env を作成してください
# cp .env.example .env

# アプリケーション
APP_NAME=PhotoFighter
DEBUG=false

# 認証（本番環境では必ず安全なランダム値に変更すること）
JWT_SECRET_KEY=CHANGE_ME_TO_SECURE_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AWS
AWS_REGION=ap-northeast-1
DYNAMODB_TABLE_USERS=photofighter-users
DYNAMODB_TABLE_CHARACTERS=photofighter-characters
S3_BUCKET_SPRITES=photofighter-sprites

# Bedrock
BEDROCK_MODEL_ID=amazon.nova-canvas-v1:0

# キャラクター生成制限
MONTHLY_GENERATION_LIMIT=5

# CORS（フロントエンドの URL を設定）
ALLOWED_ORIGINS=["http://localhost:5173"]
